{
  "name": "flow-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-flow.mjs",
    "test": "playwright test",
    "studio": "remotion studio src/video/index.ts",
