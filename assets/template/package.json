    "qa:visual": "node tools/visual-diff.mjs",
    "qa:video": "tsx tools/check-video.ts",
    "qa": "npm run validate && npm run typecheck && npm run build && npm test && npm run qa:visual && npm run render && npm run qa:video"
  },
  "dependencies": {
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.538"
