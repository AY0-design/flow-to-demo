  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@remotion/cli": "4.0.538",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "tsx": "^4.21.0"
  }
